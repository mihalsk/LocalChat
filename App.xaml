<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:LocalChat.Converters"
             x:Class="LocalChat.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToAlignmentConverter x:Key="BoolToAlignment" />
            <converters:BoolToColorConverter x:Key="BoolToColor" />
            <converters:BoolToCornerRadiusConverter x:Key="BoolToCornerRadiusConverter" />
            <!-- Базовые цвета (опционально) -->
            <Color x:Key="Primary">#512BD4</Color>
            <Color x:Key="White">White</Color>
            <Color x:Key="Black">Black</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>